<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="10dp"
    app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="@color/card_stroke">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvProductName" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textStyle="bold" android:textSize="14sp" android:textColor="@color/textPrimary"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipDemand"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" app:chipMinHeight="26dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvCategory" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/textSecondary" android:layout_marginTop="2dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/tvUnits" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/colorPrimary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" · " android:textSize="12sp" android:textColor="@color/textSecondary"/>
            <TextView android:id="@+id/tvRevenue" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/textPrimary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" · " android:textSize="12sp" android:textColor="@color/textSecondary"/>
            <TextView android:id="@+id/tvAvgDaily" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/textSecondary"/>
        </LinearLayout>
        <TextView android:id="@+id/tvRestock" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="12sp" android:textColor="@color/warning_orange" android:visibility="gone"/>
        <TextView android:id="@+id/tvStockout" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textSize="11sp" android:textColor="@color/error_red" android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
